      "117: func calcTxRWSetGasUsed(txSimContext protocol.TxSimContext,",
      "118: \tisTxSuccess bool,",
      "119: \tlog protocol.Logger) (uint64, error) {",
      "120: ",
      "121: \tgasRWSet := uint64(0)",
      "122: \tblockVersion := txSimContext.GetBlockVersion()",
      "123: \tif blockVersion < blockVersion2312 {",
      "124: \t\treturn gasRWSet, nil",
      "125: \t} // for block version < 2030102",
      "126: ",
      "127: \tgasConfig := gasutils.NewGasConfig(txSimContext.GetLastChainConfig().AccountConfig)",
      "128: \tif gasConfig == nil {",
      "129: \t\treturn gasRWSet, nil",
      "130: \t}",
      "131: ",
      "132: \tdataSize := 0",
      "133: \trwSet := txSimContext.GetTxRWSet(isTxSuccess)",
      "134: \tfor _, txRead := range rwSet.TxReads {",
      "135: \t\tif !utils.IsNativeContract(txRead.ContractName) {",
      "136: \t\t\tdataSize += calcReadSetItemSize(txRead)",
      "137: \t\t}",
      "138: \t\tlog.Debugf(\"【gas calc】%v, read key = %v # %v, value size = %v, dataSize = %v\",",
      "139: \t\t\ttxSimContext.GetTx().Payload.TxId, txRead.ContractName, string(txRead.Key), len(txRead.Value), dataSize)",
      "140: \t}",
      "141: \tfor _, txWrite := range rwSet.TxWrites {",
      "142: \t\tif !utils.IsNativeContract(txWrite.ContractName) {",
      "143: \t\t\tdataSize += calcWriteSetItemSize(txWrite)",
      "144: \t\t}",
      "145: \t\tlog.Debugf(\"【gas calc】%v, write key = %v # %v, value size = %v, dataSize = %v\",",
      "146: \t\t\ttxSimContext.GetTx().Payload.TxId, txWrite.ContractName, string(txWrite.Key), len(txWrite.Value), dataSize)",
      "147: \t}",
      "148: ",
      "149: \tlog.Debugf(\"【gas calc】%v, calcTxRWSetGasUsed, dataSize = %v, gas_price = %v, read_set(%v), write_set(%v)\",",
      "150: \t\ttxSimContext.GetTx().Payload.TxId,",
      "151: \t\tdataSize, gasConfig.GetGasPriceForInvoke(),",
      "152: \t\tlen(rwSet.TxReads), len(rwSet.TxWrites))",
      "153: \tgasRWSet, err := gasutils.MultiplyGasPrice(dataSize, gasConfig.GetGasPriceForInvoke())",
      "154: \tif err != nil {",
      "155: \t\treturn 0, err",
      "156: \t}",
      "157: ",
      "158: \treturn gasRWSet, nil",
      "159: }",
      "160: ",
      "161: func calcReadSetItemSize(txRead *commonPb.TxRead) int {",
      "162: \tdataSize := len(txRead.ContractName)",
      "163: ",
      "164: \tkeyLabels := strings.Split(string(txRead.Key), protocol.ContractStoreSeparator)",
      "165: \tfor _, keyLabel := range keyLabels {",
      "166: \t\tdataSize += len(keyLabel)",
      "167: \t}",
      "168: ",
      "169: \tdataSize += len(txRead.Value)",
      "170: ",
      "171: \treturn dataSize",
      "172: }",
      "173: ",
      "174: func calcWriteSetItemSize(txWrite *commonPb.TxWrite) int {",
      "175: \tdataSize := len(txWrite.ContractName)",
      "176: ",
      "177: \tkeyLabels := strings.Split(string(txWrite.Key), protocol.ContractStoreSeparator)",
      "178: \tfor _, keyLabel := range keyLabels {",
      "179: \t\tdataSize += len(keyLabel)",
      "180: \t}",
      "181: ",
      "182: \tdataSize += len(txWrite.Value)",
      "183: ",
      "184: \treturn dataSize",
      "185: }",
      "186: ",
      "187: func calcTxEventGasUsed(",
      "188: \ttxSimContext protocol.TxSimContext,",
      "189: \tevents []*commonPb.ContractEvent, log protocol.Logger) (uint64, error) {",
      "190: ",
      "191: \tgasEvents := uint64(0)",
      "192: \tblockVersion := txSimContext.GetBlockVersion()",
      "193: \tif blockVersion < blockVersion2312 {",
      "194: \t\treturn gasEvents, nil",
      "195: \t} // for block version < 2030102",
      "196: ",
      "197: \tgasConfig := gasutils.NewGasConfig(txSimContext.GetLastChainConfig().AccountConfig)",
      "198: \tif gasConfig == nil {",
      "199: \t\treturn gasEvents, nil",
      "200: \t}",
      "201: ",
      "202: \tdataSize := 0",
