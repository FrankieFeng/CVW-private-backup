      "207: \t\t\t\tdataSize += len(dataItem)",
      "208: \t\t\t}",
      "209: \t\t}",
      "210: \t\tlog.Debugf(\"【gas calc】%v, event contractName = %v, topic = %v, dataSize = %v\",",
      "211: \t\t\ttxSimContext.GetTx().Payload.TxId, event.ContractName, string(event.Topic), dataSize)",
      "212: \t}",
      "213: ",
      "214: \tlog.Debugf(\"【gas calc】%v, calcTxEventGasUsed, dataSize = %v, gas_price = %v\",",
      "215: \t\ttxSimContext.GetTx().Payload.TxId,",
      "216: \t\tdataSize, gasConfig.GetGasPriceForInvoke())",
