    "lines": [
      "49: // MultiplyGasPrice calculate multiplication of contract size(int) and gas price(float32)",
      "50: func MultiplyGasPrice(dataSize int, gasPrice float32) (uint64, error) {",
      "51: \tif gasPrice == 0 || dataSize == 0 {",
      "52: \t\treturn uint64(0), nil",
      "53: \t}",
      "54: ",
      "55: \tprice := decimal.NewFromFloat32(gasPrice)",
      "56: \tsize := decimal.NewFromInt(int64(dataSize))",
      "57: \tgas := size.Mul(price).Ceil()",
      "58: ",
      "59: \tif gas.GreaterThan(maxUint64) {",
      "60: \t\treturn 0, fmt.Errorf(\"uint64 `%v` overflow\", gas)",
      "61: \t}",
      "62: ",
      "63: \treturn gas.BigInt().Uint64(), nil",
      "64: }"
    ]
  },
