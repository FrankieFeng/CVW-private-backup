      "214: func (b *messageBusImpl) handleMessageLooping() {",
      "215: \tgo func() {",
      "216: \t\tfor {",
      "217: \t\t\tselect {",
      "218: \t\t\tcase m := <-b.safeMessageC:",
      "219: \t\t\t\tb.notify(m, true)",
      "220: \t\t\tcase <-b.quitC:",
      "221: \t\t\t\tb.mu.Lock()",
      "222: \t\t\t\t// for each top, notify subscribes that message bus is quiting now",
      "223: \t\t\t\tb.topicMap.Range(func(_, v interface{}) bool {",
      "224: \t\t\t\t\ts, _ := v.([]Subscriber)",
      "225: \t\t\t\t\tlength := len(s)",
      "226: \t\t\t\t\tfor i := 0; i < length; i++ {",
      "227: \t\t\t\t\t\ts := s[i]",
      "228: \t\t\t\t\t\tgo s.OnQuit()",
      "229: \t\t\t\t\t}",
      "230: \t\t\t\t\treturn true",
      "231: \t\t\t\t})",
      "232: \t\t\t\tb.closed = true",
      "233: \t\t\t\tb.mu.Unlock()",
      "234: \t\t\t\treturn",
      "235: \t\t\t}",
      "236: \t\t}",
      "237: \t}()",
      "238: }",
      "239: ",
      "240: // notify subscribers when msg comes",
      "241: func (b *messageBusImpl) notify(m *Message, isSafe bool) {",
      "242: \tif m.Topic <= 0 {",
      "243: \t\treturn",
      "244: \t}",
      "245: ",
      "246: \t// fetch the subscribers for topic",
      "247: \tval, _ := b.topicMap.Load(m.Topic)",
      "248: \tif val == nil {",
      "249: \t\treturn",
      "250: \t}",
      "251: \tsubs, _ := val.([]Subscriber)",
      "252: ",
      "253: \tfor _, sub := range subs {",
      "254: \t\tif isSafe {",
      "255: \t\t\tsub.OnMessage(m) // notify in order",
      "256: \t\t} else {",
      "257: \t\t\tgo sub.OnMessage(m)",
      "258: \t\t}"
    ]
  },
