+package wasmer
+
+import (
+	"chainmaker.org/chainmaker/logger/v2"
+	common "chainmaker.org/chainmaker/pb-go/v2/common"
+	w "chainmaker.org/chainmaker/vm-wasmer/v2/wasmer-go"
