      "624: \t\t\terr.Error(), tx.Payload.ChainId, tx.Payload.TxId)",
      "625: \t\ts.log.Warn(errMsg)",
      "626: ",
      "627: \t\tresp.Code = commonPb.TxStatusCode_INTERNAL_ERROR",
      "628: \t\tresp.Message = errMsg",
      "629: \t\treturn resp",
      "630: \t}",
      "631: ",
      "632: \ts.log.Debugf(\"Add tx success, chainId:%s, txId:%s\", tx.Payload.ChainId, tx.Payload.TxId)",
      "633: ",
