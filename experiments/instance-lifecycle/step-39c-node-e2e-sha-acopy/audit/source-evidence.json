      "318: // trySendTxResult try to send a tx result to channel",
      "319: // if the tx not registered, do nothing",
      "320: func (child *childDispatcher) trySendTxResult(tx *commonPb.Transaction, blockHeight uint64) {",
      "321: \tchild.mu.RLock()",
      "322: \tdefer child.mu.RUnlock()",
      "323: ",
      "324: \tif txResultC, exists := child.txRegs[tx.Payload.TxId]; exists {",
      "325: \t\tresult := &TxResultExt{",
      "326: \t\t\tResult:        tx.Result,",
      "327: \t\t\tTxTimestamp:   tx.Payload.Timestamp,",
      "328: \t\t\tTxBlockHeight: blockHeight,",
      "329: \t\t}",
      "330: \t\t// non-blocking write to channel to ignore txResultC buffer is full in extreme cases",
      "331: \t\tselect {",
      "332: \t\tcase txResultC <- result:",
      "333: \t\tdefault:",
      "334: \t\t\tlog.Warnf(\"tx [%s] result channel is full, result dropped\", tx.Payload.TxId)",
      "335: \t\t}",
      "336: \t}",
      "337: }"
    ]
