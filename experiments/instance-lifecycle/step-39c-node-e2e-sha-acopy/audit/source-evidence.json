      "202: func (r *nodeFreshRuntime) Invoke(c *common.Contract, method string, raw []byte, params map[string][]byte, tx protocol.TxSimContext, gasUsed uint64) (result *common.ContractResult, order protocol.ExecOrderTxType) {",
      "203: \tresult = &common.ContractResult{Code: 1}",
      "204: \torder = protocol.ExecOrderTxTypeNormal",
      "205: \tdefer func(){e39bCollect(r,tx.GetTx().Payload.TxId)}()",
      "206:  if c == nil || c.Name != r.contract.Name || c.Version != r.contract.Version {result.Message=\"runtime contract/hash mismatch\";return}",
      "207:  incoming:=r.hash(\"invoke_input_sha\",raw);expected:=\"\";if e39Mode==\"B\"||e39Mode==\"D\"{expected=r.artifact.digest}else{expected=r.hash(\"invoke_snapshot_sha\",r.raw)}",
      "208:  if incoming!=expected {",
      "209: \t\tresult.Message = \"runtime contract/hash mismatch\"",
      "210: \t\treturn",
      "211: \t}",
      "212: \t// No request deadline returns while tx context is still being accessed: cancellation is admission-only.",
      "213: \te := r.m.owner.Do(context.Background(), func() error {",
      "214: \t\tnodeOwnerTID.Store(int64(syscallTID()))",
      "215: \t\tcode:=raw;if e39Mode!=\"A\"{code=r.raw};return r.invoke(c, method, code, params, tx, gasUsed, result, &order)",
      "216: \t})",
      "217: \tif e != nil {",
      "218: \t\tresult.Code = 1",
      "219: \t\tresult.Message = e.Error()",
      "220: \t}",
      "221: \treturn",
      "222: }"
    ]
