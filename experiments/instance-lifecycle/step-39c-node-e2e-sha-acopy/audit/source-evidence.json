      "622: func (cc *ChainClient) sendRequest(req *common.TxRequest, timeout int64, syncResult bool) (",
      "623: \t*common.TxResponse, error) {",
      "624: \tif timeout <= 0 {",
      "625: \t\tif req.Payload.TxType == common.TxType_QUERY_CONTRACT {",
      "626: \t\t\ttimeout = cc.rpcClientConfig.rpcClientGetTxTimeout",
      "627: \t\t} else {",
      "628: \t\t\ttimeout = cc.rpcClientConfig.rpcClientSendTxTimeout",
      "629: \t\t}",
      "630: \t}",
      "631: ",
      "632: \t// canonical query",
      "633: \tif cc.enableSyncCanonicalTxResult && req.Payload.TxType == common.TxType_QUERY_CONTRACT {",
      "634: \t\treturn cc.queryCanonical(req, timeout)",
      "635: \t}",
      "636: \t// invoke tx and sync result use tx result dispatcher",
      "637: \tif cc.enableTxResultDispatcher && req.Payload.TxType == common.TxType_INVOKE_CONTRACT {",
      "638: \t\tresp, err := cc.sendTxRequestWithSyncResult(req, timeout, false)",
      "639: \t\tif err != nil {",
      "640: \t\t\treturn resp, err",
      "641: \t\t}",
      "642: \t\tif resp.Code == common.TxStatusCode_SUCCESS {",
      "643: \t\t\tif syncResult {",
      "644: \t\t\t\tr, err := cc.asyncTxResult(req.Payload.TxId, timeout)",
      "645: \t\t\t\tif err != nil {",
      "646: \t\t\t\t\treturn nil, fmt.Errorf(\"asyncTxResult failed, %s, txid: %s, %s\", err.Error(),",
      "647: \t\t\t\t\t\treq.Payload.TxId, errGetTxResultTimeout)",
      "648: \t\t\t\t}",
      "649: \t\t\t\tresp.Code = r.Result.Code",
      "650: \t\t\t\tresp.Message = r.Result.Message",
      "651: \t\t\t\tresp.ContractResult = r.Result.ContractResult",
      "652: \t\t\t\tresp.TxId = req.Payload.TxId",
      "653: \t\t\t\tresp.TxTimestamp = r.TxTimestamp",
      "654: \t\t\t\tresp.TxBlockHeight = r.TxBlockHeight",
      "655: \t\t\t}",
      "656: \t\t}",
      "657: \t\treturn resp, nil",
      "658: \t}",
      "659: \t// normal tx request, query/invoke etc.",
      "660: \t// result will be included in response if tx is TxType_INVOKE_CONTRACT and syncResult is true, otherwise not",
      "661: \treturn cc.sendTxRequestWithSyncResult(req, timeout, syncResult)",
      "662: }",
      "663: ",
      "664: // sendTxRequestWithSyncResult normal tx request, query/invoke etc.",
      "665: // result will be included in response if tx is invoke and syncResult is true, otherwise not",
      "666: func (cc *ChainClient) sendTxRequestWithSyncResult(req *common.TxRequest, timeout int64, syncResult bool) (",
      "667: \t*common.TxResponse, error) {",
      "668: ",
      "669: \tvar (",
      "670: \t\tresp *common.TxResponse",
      "671: \t\t// polling result compatible.",
      "672: \t\t// if syncResult is true, and polling config is set, and tx is TxType_INVOKE_CONTRACT then polling tx result",
      "673: \t\t// add nodeOnlyAsync for async get response, will get resp by txid when nodeOnlyAsync is true",
      "674: \t\tpollingResultCompatible = syncResult && cc.retryLimit > 0 && cc.retryInterval > 0 && cc.nodeOnlyAsync &&",
      "675: \t\t\treq.Payload.TxType == common.TxType_INVOKE_CONTRACT",
      "676: \t\tignoreAddrs = make(map[string]struct{})",
      "677: \t)",
      "678: ",
      "679: \tfor {",
      "680: \t\tnetCli, err := cc.pool.getClientWithIgnoreAddrs(ignoreAddrs)",
      "681: \t\tif err != nil {",
      "682: \t\t\treturn nil, err",
      "683: \t\t}",
      "684: ",
      "685: \t\tif len(ignoreAddrs) > 0 {",
      "686: \t\t\tcc.logger.Debugf(\"[SDK] begin try to connect node [%s]\", netCli.ID)",
      "687: \t\t}",
      "688: \t\tif !syncResult {",
      "689: \t\t\t// send request async",
      "690: \t\t\tresp, err = netCli.sendRequest(req, timeout)",
      "691: \t\t} else if pollingResultCompatible {",
      "692: \t\t\t// polling result compatible",
      "693: \t\t\tresp, err = netCli.sendRequest(req, timeout)",
      "694: \t\t} else {",
      "695: \t\t\t// send request sync",
      "696: \t\t\tresp, err = netCli.sendRequestSync(req, timeout)",
      "697: \t\t}",
      "698: \t\tif err != nil {",
      "699: \t\t\tstatusErr, ok := status.FromError(err)",
      "700: \t\t\tif ok {",
      "701: \t\t\t\tif statusErr.Code() == codes.Unavailable {",
      "702: \t\t\t\t\tcc.logger.Errorf(\"[SDK] request to [%s] failed %s, try to connect another node\",",
      "703: \t\t\t\t\t\tnetCli.ID, err.Error())",
      "704: \t\t\t\t\tignoreAddrs[netCli.ID] = struct{}{}",
      "705: \t\t\t\t\tcontinue",
      "706: \t\t\t\t} else if statusErr.Code() == codes.Unknown &&",
      "707: \t\t\t\t\tstrings.Contains(err.Error(), \"malformed header: missing HTTP content-type\") {",
      "708: \t\t\t\t\tnetCli.conn.Close()",
      "709: \t\t\t\t\tconn, err := cc.pool.initGRPCConnect(netCli.nodeAddr, netCli.useTLS, netCli.caPaths,",
      "710: \t\t\t\t\t\tnetCli.caCerts, netCli.tlsHostName)",
      "711: \t\t\t\t\tif err != nil {",
      "712: \t\t\t\t\t\tcc.pool.getLogger().Errorf(\"init grpc connection [%s] failed, %s\",",
      "713: \t\t\t\t\t\t\tnetCli.ID, err.Error())",
      "714: \t\t\t\t\t\tignoreAddrs[netCli.ID] = struct{}{}",
      "715: \t\t\t\t\t\tcontinue"
    ]
  }
