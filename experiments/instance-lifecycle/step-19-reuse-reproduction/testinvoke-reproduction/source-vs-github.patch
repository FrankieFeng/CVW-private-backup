+// isUserContract check if it is user contract
+func (m *VmManagerImpl) isUserContract(refTxType commonPb.TxType) bool {
+	switch refTxType {
+	case
+		commonPb.TxType_INVOKE_CONTRACT,
+		commonPb.TxType_QUERY_CONTRACT:
+		return true
+	default:
+		return false
+	}
+}
