diff --git a/.worktrees/cvw-step25/experiments/instance-lifecycle/step-25-ab-copy-screening/source/vm/step25_test.go b/.worktrees/cvw-step25/experiments/instance-lifecycle/step-25-ab-copy-screening/source/vm/step25_test.go
