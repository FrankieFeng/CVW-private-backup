+// Step33 history fixture is derived only from actually committed RW writes.
+// No canned iterator values or business return values are supplied.
+type s33HistoryIter struct { values []*historypb.KeyModification; index int; closed bool }
+func (i *s33HistoryIter) Next() bool { if i.closed { return false }; i.index++;return i.index<len(i.values) }
+func (i *s33HistoryIter) Value() (*historypb.KeyModification,error) { if i.closed || i.index<0 || i.index>=len(i.values) {return nil,fmt.Errorf("history iterator outside valid entry")};return i.values[i.index],nil }
+func (i *s33HistoryIter) Release() { i.closed=true }
