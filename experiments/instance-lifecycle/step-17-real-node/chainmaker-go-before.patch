diff --git a/scripts/build_release.sh b/scripts/build_release.sh
index bb4fe12..7877742 100755
--- a/scripts/build_release.sh
+++ b/scripts/build_release.sh
@@ -47,6 +47,31 @@ function build() {
     make
 }
 
+function resolve_wasmer_lib() {
+    local resolved=""
+    if [ "${system}" = "Linux" ]; then
+        # Prefer the libwasmer bundled in vm-wasmer module, which keeps in sync
+        # with vm-wasmer interface changes (for example, wasm_config_set_backend).
+        local vm_wasmer_dir=""
+        vm_wasmer_dir=$(cd "$PROJECT_PATH" && GOWORK=off go list -m -f '{{.Dir}}' chainmaker.org/chainmaker/vm-wasmer/v2 2>/dev/null || true)
+        if [ -n "$vm_wasmer_dir" ] && [ -f "$vm_wasmer_dir/wasmer-go/packaged/lib/linux-amd64/libwasmer.so" ]; then
+            resolved="$vm_wasmer_dir/wasmer-go/packaged/lib/linux-amd64/libwasmer.so"
+        elif [ -f "$PROJECT_PATH/main/libwasmer_runtime_c_api.so" ]; then
+            resolved="$PROJECT_PATH/main/libwasmer_runtime_c_api.so"
+        fi
+    else
+        if [ -f "$PROJECT_PATH/main/libwasmer.dylib" ]; then
+            resolved="$PROJECT_PATH/main/libwasmer.dylib"
+        fi
+    fi
+
+    if [ -z "$resolved" ]; then
+        echo "failed to locate wasmer runtime library"
+        exit 1
+    fi
+    echo "$resolved"
+}
+
 function package() {
     if [ -d $RELEASE_PATH ]; then
         mkdir -p $BACKUP_PATH/backup_release
@@ -55,6 +80,9 @@ function package() {
 
     mkdir -p $RELEASE_PATH
     cd $RELEASE_PATH
+    local wasmer_lib_source
+    wasmer_lib_source=$(resolve_wasmer_lib)
+    echo "using wasmer runtime library: $wasmer_lib_source"
     echo "tar zcf crypto-config..."
     tar -zcf crypto-config-$DATETIME.tar.gz ../crypto-config
 
@@ -79,10 +107,10 @@ function package() {
         cp $CURRENT_PATH/bin/docker-vm-standalone-stop.sh   $chainmaker_file/bin
         cp $CURRENT_PATH/service/*        $chainmaker_file/bin
         if [ "${system}" = "Linux" ]; then
-          cp -r $PROJECT_PATH/main/libwasmer_runtime_c_api.so     $chainmaker_file/lib/libwasmer.so
+          cp -r "$wasmer_lib_source"                              $chainmaker_file/lib/libwasmer.so
           cp -r $PROJECT_PATH/main/prebuilt/linux/wxdec           $chainmaker_file/lib/
         else
-          cp -r $PROJECT_PATH/main/libwasmer.dylib                $chainmaker_file/lib/
+          cp -r "$wasmer_lib_source"                              $chainmaker_file/lib/
           cp -r $PROJECT_PATH/main/prebuilt/mac/wxdec             $chainmaker_file/lib/
         fi
         chmod 644 $chainmaker_file/lib/*
