diff --git a/chainmaker/chainmaker-vm-wasmer/vm-wasmer/v2@v2.4.0/step21a_guard.go b/chainmaker/chainmaker-vm-wasmer/vm-wasmer/v2@v2.4.0/step21a_guard.go
