+package wasmer
+
+import (
+	common "chainmaker.org/chainmaker/pb-go/v2/common"
+	"encoding/json"
+	"os"
+	"sort"
+	"testing"
+)
+
+func TestStep23BuyNow(t *testing.T) {
+	if !e22Enabled {
+		t.Fatal("explicit cached serial path required")
+	}
+	condition := os.Getenv("E23_CONDITION")
+	if condition != "R0" && condition != "R1" && condition != "C1" {
+		t.Fatal("unregistered condition")
+	}
+	if os.Getenv("D_POLICY") != "R1" && condition != "R0" {
+		t.Fatal("Fresh policy mismatch")
+	}
+	defer dOwner(t)()
+	var inputs struct {
+		RootTxID  string            `json:"root_tx_id"`
+		RootInput map[string]string `json:"root_input"`
+		Initial   string            `json:"expected_initial_hash"`
+		Final     string            `json:"expected_final_hash"`
+	}
+	b, e := os.ReadFile(os.Getenv("E23_INPUTS"))
+	if e != nil {
+		t.Fatal(e)
+	}
+	if json.Unmarshal(b, &inputs) != nil {
+		t.Fatal("invalid frozen input")
+	}
+	f := s21cPrepare(t, os.Getenv("D_MANIFEST"), os.Getenv("D_OUTPUT"))
+	defer f.close()
+	m := f.instances
+	for _, n := range []string{"identity", "erc721", "exchange"} {
+		c, _ := f.snapshot.store.GetContractByName(n)
+		code, _ := f.snapshot.store.GetContractBytecode(n)
+		if e = m.e22Prepare(c, code); e != nil {
+			t.Fatal(e)
+		}
+	}
+	m.e22.variant = "A0"
+	if condition == "C1" {
+		m.e22.variant = "A1"
+	}
+	m.e22.validate = true // Gas diagnosis only, never used as a performance sample.
+	for _, n := range []string{"identity", "erc721", "exchange"} {
+		args := map[string]string{}
+		if n == "erc721" {
+			args = map[string]string{"name": "huanletoken", "symbol": "hlt", "tokenURI": "https://chainmaker.org.cn"}
+		}
+		a23LedgerBefore = f.snapshot.hash()
+		r := f.run("init-"+n, n, "init_contract", "step21c-init-"+n, args)
+		if r.Result.Code != 0 || r.Status != common.TxStatusCode_SUCCESS {
+			t.Fatalf("actual init failed %+v", r.Result)
+		}
+	}
+	a23LedgerBefore = f.snapshot.hash()
+	if a23LedgerBefore != inputs.Initial {
+		t.Fatalf("initial ledger differs: %s", a23LedgerBefore)
+	}
+	r := f.run("target", "exchange", "buyNow", inputs.RootTxID, inputs.RootInput)
+	if r.Result.Code != 0 || r.Status != common.TxStatusCode_SUCCESS || string(r.Result.Result) != "buyNow success" {
+		t.Fatalf("actual root failed %+v", r.Result)
+	}
+	if r.BeforeHash != inputs.Initial || r.AfterHash != inputs.Final {
+		t.Fatalf("business ledger differs %s %s", r.BeforeHash, r.AfterHash)
+	}
+	if f.state("erc721", "tokenIds", inputs.RootInput["tokenId"]) != inputs.RootInput["to"] {
+		t.Fatal("owner did not transfer")
+	}
+	if f.state("identity", "identity", inputs.RootInput["from"]) != "1" || f.state("identity", "identity", inputs.RootInput["to"]) != "1" {
+		t.Fatal("whitelist missing")
+	}
+	if f.state("erc721", "operatorApprove", inputs.RootInput["from"]+"_"+f.member.uid) != "1" {
+		t.Fatal("operator approval missing")
+	}
+	expected := []string{"exchange/buyNow", "identity/addWriteList", "identity/isApprovedUser", "identity/isApprovedUser", "erc721/mint", "erc721/setApprovalForAll2", "erc721/transferFrom"}
+	calls := append([]s21cCall(nil), r.Calls...)
+	sort.Slice(calls, func(i, j int) bool { return calls[i].ID < calls[j].ID })
+	if len(calls) != 7 {
+		t.Fatal("root plus six real calls required")
+	}
+	for i, c := range calls {
+		if c.ID != i || c.Contract+"/"+c.Method != expected[i] || c.Code != 0 || i > 0 && c.Depth != 1 {
+			t.Fatal("real call graph/result differs")
+		}
+	}
+	if len(a23Stack) != 0 || len(a23Calls) != 0 || len(eActive) != 0 {
+		t.Fatal("observer stack not empty")
+	}
+	dEvent("boundary", map[string]interface{}{"condition": condition, "root_gas": r.Result.GasUsed})
+	eEmit(map[string]interface{}{"event": "root_checked", "condition": condition, "gas": r.Result.GasUsed, "before": r.BeforeHash, "after": r.AfterHash, "real_child_count": 6, "table_function_identity": "not_tested", "exception_paths": "not_tested", "S1_memory_checked_on_each_creation": true})
+}
--- a/source/vm/step23_diagnostics.go
+++ b/source/vm/step23_diagnostics.go
@@ -0,0 +1,162 @@
+package wasmer
+
+import (
+	common "chainmaker.org/chainmaker/pb-go/v2/common"
+	"chainmaker.org/chainmaker/protocol/v2"
+	w "chainmaker.org/chainmaker/vm-wasmer/v2/wasmer-go"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"syscall"
+)
+
+// All observers run on the existing owner. No guest call is added by these helpers.
+type a23Call struct {
+	StateObserverVersion string                 `json:"state_observer_version"`
+	StateOps             []a23StateOperation    `json:"own_state_operations"`
+	CallID               int                    `json:"call_id"`
+	ParentCallID         int                    `json:"parent_call_id"`
+	Depth                int                    `json:"depth"`
+	Caller               string                 `json:"caller"`
+	Contract             string                 `json:"contract"`
+	Method               string                 `json:"method"`
+	TxID                 string                 `json:"tx_id"`
+	InstanceID           int                    `json:"instance_id"`
+	InstanceGoID         string                 `json:"instance_go_id"`
+	StoreID              string                 `json:"store_id"`
+	ModuleID             string                 `json:"module_go_id"`
+	Variant              string                 `json:"variant"`
+	CacheKey             string                 `json:"cache_key"`
+	SourceSHA            string                 `json:"source_sha"`
+	UsesBefore           int                    `json:"instance_uses_before"`
+	Params               json.RawMessage        `json:"actual_parameters"`
+	InputSHA             string                 `json:"input_sha"`
+	LedgerBefore         string                 `json:"initial_ledger_sha"`
+	RWBefore             json.RawMessage        `json:"state_observation_before"`
+	RWAfter              json.RawMessage        `json:"state_observation_after"`
+	GasIn                uint64                 `json:"gas_in_cumulative"`
+	GasOut               uint64                 `json:"gas_out_cumulative"`
+	GetterRemaining      uint64                 `json:"getter_remaining_final"`
+	GetterVerifications  int                    `json:"getter_verifications"`
+	BeforeSetRemaining   *uint64                `json:"remaining_before_setgas,omitempty"`
+	BeforeSetStatus      string                 `json:"before_setgas_status"`
+	Result               *common.ContractResult `json:"actual_result"`
+	CallError            string                 `json:"call_error_observed"`
+	BridgeSeq            int                    `json:"bridge_seq_count"`
+}
+
+var a23Stack []*a23Call
+var a23Calls = map[*SimContext]*a23Call{}
+var a23LedgerBefore string
+
+func a23Hash(b []byte) string { h := sha256.Sum256(b); return hex.EncodeToString(h[:]) }
+func a23JSON(x interface{}) json.RawMessage {
+	b, e := json.Marshal(x)
+	if e != nil {
+		panic(e)
+	}
+	return b
+}
+func a23RW(_ protocol.TxSimContext) json.RawMessage {
+	return a23JSON(map[string]interface{}{"scope": "forwarded business Get/Put/Del operation prefix; no internal RW map access", "observer_enabled": eTraceEnabled, "operations": a23AllOperations})
+}
+
+func a23Enter(id, depth int, contract *common.Contract, method string, params map[string][]byte, ctx protocol.TxSimContext, gas uint64) *a23Call {
+	w.ManagedAssert()
+	if depth == 0 {
+		a23AllOperations = nil
+	}
+	parent := -1
+	caller := "external"
+	if len(a23Stack) > 0 {
+		p := a23Stack[len(a23Stack)-1]
+		parent = p.CallID
+		caller = p.Contract
+	}
+	j := a23JSON(params)
+	c := &a23Call{StateObserverVersion: "v2_forwarded_operations", CallID: id, ParentCallID: parent, Depth: depth, Caller: caller, Contract: contract.Name, Method: method, TxID: ctx.GetTx().Payload.TxId, Params: j, InputSHA: a23Hash(j), RWBefore: a23RW(ctx), GasIn: gas, LedgerBefore: a23LedgerBefore}
+	a23Stack = append(a23Stack, c)
+	eEmit(map[string]interface{}{"event": "call_enter", "call_id": id, "parent_call_id": parent, "caller": caller, "contract": c.Contract, "method": method, "depth": depth, "tx_id": c.TxID, "gas_in_cumulative": gas, "input_sha": c.InputSHA, "owner_tid": syscall.Gettid()})
+	return c
+}
+func a23Bind(c *a23Call, inst *w.Instance, id, used int, storeID, moduleID, key, variant, sourceSHA string) {
+	c.InstanceID = id
+	c.InstanceGoID = fmt.Sprintf("%p", inst)
+	c.UsesBefore = used
+	c.StoreID = storeID
+	c.ModuleID = moduleID
+	c.CacheKey = key
+	c.Variant = variant
+	c.SourceSHA = sourceSHA
+}
+func a23BeforeSet(c *a23Call, inst *w.Instance) {
+	c.BeforeSetStatus = "not_observed_probe_off"
+	if !eTraceEnabled {
+		return
+	}
+	slot := eSlots[c.Contract]
+	mem, e := inst.Exports.GetMemory("memory")
+	if e != nil {
+		panic(e)
+	}
+	d := mem.Data()
+	if slot.Slot+8 > uint64(len(d)) {
+		panic("verified slot out of bounds")
+	}
+	ptr := binary.LittleEndian.Uint64(d[slot.Slot : slot.Slot+8])
+	if ptr == 0 {
+		c.BeforeSetStatus = "registry_not_initialized_before_SetGas"
+		return
+	}
+	if ptr+8 > uint64(len(d)) {
+		panic("counter pointer out of bounds")
+	}
+	remain := binary.LittleEndian.Uint64(d[ptr : ptr+8])
+	c.BeforeSetRemaining = &remain
+	c.BeforeSetStatus = "prior_instance_state; not current-call charged Gas"
+}
+func a23Enrich(sc *SimContext, fields map[string]interface{}) {
+	if c := a23Calls[sc]; c != nil {
+		fields["call_id"] = c.CallID
+		fields["parent_call_id"] = c.ParentCallID
+		fields["caller"] = c.Caller
+		fields["store_id"] = c.StoreID
+		fields["module_go_id"] = c.ModuleID
+		fields["instance_uses_before"] = c.UsesBefore
+		fields["variant"] = c.Variant
+		fields["owner_tid"] = syscall.Gettid()
+	}
+}
+func a23Bridge(sc *SimContext, when string, isLen bool, gas uint64, result *common.ContractResult) {
+	if !eTraceEnabled {
+		return
+	}
+	c := a23Calls[sc]
+	if c == nil {
+		panic("bridge without current call")
+	}
+	if when == "before_wacsi" {
+		c.BridgeSeq++
+	}
+	fields := map[string]interface{}{"event": "bridge_gas", "tx_id": c.TxID, "contract": c.Contract, "method": c.Method, "depth": c.Depth, "when": when, "is_len": isLen, "bridge_seq": c.BridgeSeq, "gas_argument_or_return_cumulative": gas, "parent_remaining_readonly": eRawGas(sc.Instance, sc.Contract.Name)}
+	if result != nil {
+		fields["callee_result_gas_cumulative"] = result.GasUsed
+		fields["callee_code"] = result.Code
+		fields["callee_result"] = result.Result
+	}
+	a23Enrich(sc, fields)
+	eEmit(fields)
+}
+func a23Finish(c *a23Call, result *common.ContractResult, ctx protocol.TxSimContext) {
+	w.ManagedAssert()
+	if len(a23Stack) == 0 || a23Stack[len(a23Stack)-1] != c {
+		panic("diagnostic call stack mismatch")
+	}
+	c.RWAfter = a23RW(ctx)
+	c.Result = result
+	c.GasOut = result.GasUsed
+	eEmit(map[string]interface{}{"event": "call_record", "record": c, "owner_tid": syscall.Gettid()})
+	a23Stack = a23Stack[:len(a23Stack)-1]
+}
--- a/source/vm/step23_probe.go
+++ b/source/vm/step23_probe.go
@@ -0,0 +1,116 @@
+package wasmer
+
+import (
+	w "chainmaker.org/chainmaker/vm-wasmer/v2/wasmer-go"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"os"
+	"runtime"
+	"syscall"
+	"time"
+)
+
+type eSlot struct {
+	Slot uint64 `json:"slot"`
+	SHA  string `json:"sha256"`
+}
+
+var eSlots = func() map[string]eSlot {
+	p := os.Getenv("E_COUNTERS")
+	if p == "" {
+		return nil
+	}
+	b, e := os.ReadFile(p)
+	if e != nil {
+		panic(e)
+	}
+	var v map[string]eSlot
+	if e = json.Unmarshal(b, &v); e != nil {
+		panic(e)
+	}
+	return v
+}()
+var eTraceEnabled = os.Getenv("E_GAS_TRACE") == "1"
+var eActive = map[*w.Instance]*SimContext{}
+var eEpoch = time.Now()
+
+func eEmit(v map[string]interface{}) {
+	v["monotonic_ns"] = time.Since(eEpoch).Nanoseconds()
+	v["condition"] = os.Getenv("E23_CONDITION")
+	v["experiment_stage"] = os.Getenv("E23_STAGE")
+	v["block"] = os.Getenv("E23_BLOCK")
+	v["run_label"] = os.Getenv("E23_LABEL")
+	b, e := json.Marshal(v)
+	if e != nil {
+		panic(e)
+	}
+	fmt.Printf("STEP23 %s\n", b)
+}
+func eRawGas(inst *w.Instance, contract string) uint64 {
+	w.ManagedAssert()
+	slot, ok := eSlots[contract]
+	if !ok {
+		panic("no verified counter slot: " + contract)
+	}
+	mem, e := inst.Exports.GetMemory("memory")
+	if e != nil {
+		panic(e)
+	}
+	data := mem.Data()
+	if slot.Slot+8 > uint64(len(data)) {
+		panic("counter slot out of bounds")
+	}
+	pointer := binary.LittleEndian.Uint64(data[slot.Slot : slot.Slot+8])
+	if pointer == 0 || pointer+8 > uint64(len(data)) {
+		panic("counter pointer out of bounds")
+	}
+	return binary.LittleEndian.Uint64(data[pointer : pointer+8])
+}
+func eGas(sc *SimContext, phase, host, when, detail string) {
+	if !eTraceEnabled || sc == nil {
+		return
+	}
+	sc.eSeq++
+	remain := eRawGas(sc.Instance, sc.Contract.Name)
+	fields := map[string]interface{}{"event": "gas", "contract": sc.Contract.Name, "method": sc.method, "tx_id": sc.TxSimContext.GetTx().Payload.TxId, "depth": sc.TxSimContext.GetDepth(), "instance_id": sc.lifecycleID, "policy": sc.ePolicy, "seq": sc.eSeq, "phase": phase, "host": host, "when": when, "detail": detail, "remaining": remain, "gas_absolute": runtimeGasLimit - remain}
+	a23Enrich(sc, fields)
+	eEmit(fields)
+}
+func eVerifyGas(inst *w.Instance, contract string, expected uint64) {
+	if !eTraceEnabled {
+		return
+	}
+	actual := eRawGas(inst, contract)
+	if sc := eActive[inst]; sc != nil {
+		if c := a23Calls[sc]; c != nil {
+			c.GetterVerifications++
+		}
+	}
+	if actual != expected {
+		panic(fmt.Sprintf("raw counter mismatch %d != GetGas %d", actual, expected))
+	}
+}
+
+type eMeasure struct {
+	time  time.Time
+	usage syscall.Rusage
+	gc    runtime.MemStats
+}
+
+func eBeginMeasure() eMeasure {
+	var m eMeasure
+	runtime.ReadMemStats(&m.gc)
+	syscall.Getrusage(syscall.RUSAGE_THREAD, &m.usage)
+	m.time = time.Now()
+	return m
+}
+func eEndMeasure(m eMeasure, sc *SimContext) {
+	elapsed := time.Since(m.time).Nanoseconds()
+	var u syscall.Rusage
+	syscall.Getrusage(syscall.RUSAGE_THREAD, &u)
+	var gc runtime.MemStats
+	runtime.ReadMemStats(&gc)
+	cpu := (u.Utime.Nano() + u.Stime.Nano()) - (m.usage.Utime.Nano() + m.usage.Stime.Nano())
