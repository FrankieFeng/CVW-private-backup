+// ManagedLiveCount is an owner-only read of this scope's registered live objects.
+// It does not enter native code or weaken any lifecycle/thread guard.
+func (s *ManagedScope) ManagedLiveCount() int {
+	ManagedAssert()
+	if s.closed {
+		panic("count on closed scope")
+	}
+	n := 0
+	for _, e := range s.entries {
+		if e.live {
+			n++
+		}
+	}
+	return n
+}
