diff --git a/.worktrees/cvw-step27/experiments/instance-lifecycle/step-27-normalcal-diagnostic/source/vm/step27_test.go b/.worktrees/cvw-step27/experiments/instance-lifecycle/step-27-normalcal-diagnostic/source/vm/step27_test.go
